# ==============================================================================
# SnapCut AI — Production Environment Variables Configuration Template
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. VERCEL ENVIRONMENT VARIABLES (Frontend Web App)
# Configure these in: Vercel Dashboard -> Project Settings -> Environment Variables
# Targets: Production, Preview, Development
# ------------------------------------------------------------------------------

# Supabase Auth & PostgreSQL Database
# (Obtain from: Supabase Dashboard -> Project Settings -> API)
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_public_key

# n8n AI Background Removal Webhook Endpoint
# (Obtain from: Your n8n Workflow Webhook Trigger Node)
VITE_N8N_WEBHOOK_URL=https://your-instance.app.n8n.cloud/webhook/your-webhook-id

# Razorpay Checkout Public Key (Safe for client-side modal)
# (Obtain from: Razorpay Dashboard -> Settings -> API Keys)
VITE_RAZORPAY_KEY_ID=rzp_live_your_razorpay_key_id

# Cloudinary Direct Client Upload (Optional, for fallback direct uploads)
VITE_CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
VITE_CLOUDINARY_UPLOAD_PRESET=snapcut_temp_unsigned

# Application Public Canonical URL
VITE_APP_URL=https://snapcut-five.vercel.app

# Optional Custom Backend Base URL (if using custom Node/Python backend instead of Supabase)
VITE_API_BASE_URL=https://api.snapcut.ai

# Optional: Razorpay Business KYC Details (Contact, Terms, Refund compliance)
VITE_BUSINESS_TRADE_NAME=SnapCut AI
VITE_BUSINESS_LEGAL_NAME=SnapCut AI
VITE_BUSINESS_EMAIL=support@snapcut.ai
VITE_BUSINESS_BILLING_EMAIL=billing@snapcut.ai
VITE_BUSINESS_PHONE=+91 98765 43210
VITE_BUSINESS_ADDRESS=SnapCut AI, Plot 12, Financial District, Nanakramguda, Hyderabad, Telangana 500032, India
VITE_BUSINESS_WEBSITE=https://snapcut-five.vercel.app
VITE_BUSINESS_GSTIN=

# ------------------------------------------------------------------------------
# 2. VERCEL SERVERLESS FUNCTION SECRETS (Server-side / Edge only)
# Configure in: Vercel Dashboard -> Project Settings -> Environment Variables
# IMPORTANT: Never prefix with VITE_ to keep 100% private from browser bundles
GEMINI_API_KEY=your_google_gemini_api_key_here

# ------------------------------------------------------------------------------
# 3. REACT BITS PRO COMPONENT REGISTRY LICENSE KEY
# Required for installing components via shadcn CLI (@reactbits-starter)
# (Obtain from: React Bits Pro Dashboard / Purchase confirmation)
# ------------------------------------------------------------------------------
REACTBITS_LICENSE_KEY=your_reactbits_license_key_here

# ------------------------------------------------------------------------------
# 3. SUPABASE EDGE FUNCTION SECRETS
# Configure via Supabase CLI or Supabase Dashboard -> Edge Functions -> Secrets:
# Command: supabase secrets set GEMINI_API_KEY=your_google_gemini_api_key
# ------------------------------------------------------------------------------
# GEMINI_API_KEY=your_google_gemini_api_key_here

# ------------------------------------------------------------------------------
# 4. n8n AUTOMATION CREDENTIALS (Configured inside n8n workflow nodes)
# ------------------------------------------------------------------------------
# - Clipdrop API Key: Configured in n8n HTTP Request node as header 'x-api-key'
# - Cloudinary API Secret & Key: Configured in n8n Cloudinary node credentials
# ==============================================================================
