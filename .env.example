# SnapCut AI Frontend Environment Configuration

# Custom Backend API Base URL (optional for custom backend)
VITE_API_BASE_URL=http://localhost:5000/api

# Client App URL
VITE_APP_URL=http://localhost:5173

# Optional: Razorpay Public Key ID (for client checkout modal)
VITE_RAZORPAY_KEY_ID=rzp_test_your_razorpay_key_id

# Optional: Cloudinary Cloud Name (if using client-side direct uploads)
VITE_CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
VITE_CLOUDINARY_UPLOAD_PRESET=snapcut_temp_unsigned

# Supabase Auth & Database Configuration
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key

# n8n AI Background Removal Webhook URL
VITE_N8N_WEBHOOK_URL=https://your-instance.app.n8n.cloud/webhook/your-webhook-id

# Gemini AI Chatbot Server Secret (Supabase Edge Function & local dev proxy)
# Set in Supabase: supabase secrets set GEMINI_API_KEY=your_gemini_api_key
# Never prefix with VITE_ so it remains completely private from frontend bundles
GEMINI_API_KEY=your_gemini_api_key_here
